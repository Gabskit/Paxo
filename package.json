{
	"name": "paxo",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"antlr": "antlr-ng -Dlanguage=Go -o ./Src/Bcgen ./Src/Bcgen/Paxo.g4",
		"build:bcg": "go build -o ./Build/Bcg ./Src/Bcgen/",
		"build:vm": "gcc --std=gnu23 -O3 -Wall -Wextra ./Src/Vm/Src/Main.c -o ./Build/Vm/Lepvm",
		"build": "npm run antlr && npm run build:bcg && npm run build:vm"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "Ecosistema de lenguaje y VM con aritmética Mobile Point (MP)",
	"dependencies": {
		"antlr4": "^4.13.2"
	},
	"devDependencies": {
		"antlr-ng": "^1.0.10",
		"antlr4ng-cli": "^2.0.0"
	}
}