// Prueba de fuentes: cargar, métricas verticales y rasterizar un glifo.
// Requiere PAXO_HAS_FONT; si falta, font_load retorna 0 y se degrada.

var f = font_load("Src/Testfiles/Comfortaa-Bold.ttf");
(f > 0) ? .✓ -> {
    println("fuente cargada, handle ", f);

    var m = font_metrics(f, 32);
    println("métricas 32px: asc=", m[0], " desc=", m[1], " gap=", m[2]);

    // glifo 'A' (65): [w, h, offset_x, offset_y, avance, bytes...]
    var g = font_glyph(f, 65, 32);
    println("glifo A: ", g[0], "x", g[1], ", avance=", g[4]);

    font_free(f);
} : _ -> {
    println("fuente no disponible");
};
