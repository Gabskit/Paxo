// Prueba de física: bola cayendo con gravedad y rebotando en el suelo
local var sp = phys_space();
phys_gravity(sp, 0, -1000);
local var suelo = phys_body_static(sp);
local var piso = phys_segment(sp, suelo, -500, 0, 500, 0, 1);
phys_friction(piso, 5);
local var bola = phys_body(sp, 10, 100);
local var circulo = phys_circle(sp, bola, 0, 0, 25);
phys_elasticity(circulo, 9);
local var i = 0;
phys_set_pos(bola, 0, 500);
(i < 6) : |> |:{
  local var j = 0;
  (j < 30) : |> |:{
    phys_step(sp, 1 ÷ 60);
    j++;
  }:|
  local var p = phys_pos(bola);
  println(p[1]);
  i++;
}:|
local var v = phys_vel(bola);
println(v[1]);
phys_free_space(sp);
